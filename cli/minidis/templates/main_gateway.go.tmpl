// Command {{.Name}} is a Discord bot built with minidis.
package main

import (
	"context"
	"errors"
	"log"
	"os"
	"os/signal"
	"syscall"

	"github.com/tbdsux/minidis"

	"{{.Package}}/commands"
	"{{.Package}}/events"
)

func main() {
	if err := run(); err != nil {
		log.Fatal(err)
	}
}

func run() error {
	token := os.Getenv("TOKEN")
	if token == "" {
		return errors.New("set TOKEN to the bot token from the Discord Developer Portal")
	}

	bot := minidis.New(token)

	// GUILD is a server to register the commands in, where they show up at
	// once. Without it, they are registered globally.
	bot.SetGuilds(os.Getenv("GUILD"))

	commands.Register(bot)
	events.Register(bot)

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	context.AfterFunc(ctx, stop) // a second Ctrl+C ends a slow shutdown at once

	// Run registers the commands with Discord, replacing any registered
	// before, connects with the intents the handlers need, and keeps the bot
	// running until Ctrl+C.
	return bot.Run(ctx)
}
